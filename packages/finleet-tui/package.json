  "dependencies": {
    "finleet-core": "*",
    "jimp": "^1.6.1",
    "opentui-math": "^0.1.0",
    "supports-terminal-graphics": "^0.1.0",
    "terminal-image": "^5.0.1",
    "ws": "^8.21.3"
  }
}
